// Shared by every flavor. Only PUBLIC values belong here: anything shipped in the app is extractable.
// Real secrets come from the backend after login. Local overrides go in an untracked *.secrets.xcconfig.

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

PRODUCT_NAME = ProjectTemplate
BASE_BUNDLE_IDENTIFIER = com.technonext.projecttemplate
// .dev / .stg suffix lets all three flavors live side by side on one device.
PRODUCT_BUNDLE_IDENTIFIER = $(BASE_BUNDLE_IDENTIFIER)$(BUNDLE_ID_SUFFIX)
INFOPLIST_KEY_CFBundleDisplayName = $(APP_DISPLAY_NAME)

IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 6.0

// Partial Info.plist merged into the generated one: carries APP_ENV / BASE_URL for Env.swift.
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = App/Resources/Info.plist
