{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is used to scan codes and take photos you choose to upload."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোড স্ক্যান করতে এবং আপনার বাছাই করা ছবি তুলতে ক্যামেরা ব্যবহার করা হয়।"
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contacts are used only when you choose to invite or send to a friend."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি বন্ধুকে আমন্ত্রণ বা পাঠাতে চাইলে শুধু তখনই কন্টাক্ট ব্যবহার করা হয়।"
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID keeps your account locked when you leave the app."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপ থেকে বের হলে Face ID আপনার অ্যাকাউন্ট লক রাখে।"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is used to find delivery addresses and nearby stores."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডেলিভারির ঠিকানা ও কাছের দোকান খুঁজতে আপনার অবস্থান ব্যবহার করা হয়।"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The microphone is used when you record voice notes or videos."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভয়েস নোট বা ভিডিও রেকর্ড করার সময় মাইক্রোফোন ব্যবহার করা হয়।"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo access lets you pick images to upload."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপলোড করার জন্য ছবি বাছাই করতে ফটো অ্যাক্সেস প্রয়োজন।"
          }
        }
      }
    },
    "NSUserTrackingUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This lets us show you more relevant offers."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এর মাধ্যমে আমরা আপনাকে আরও প্রাসঙ্গিক অফার দেখাতে পারি।"
          }
        }
      }
    }
  },
  "version" : "1.0"
