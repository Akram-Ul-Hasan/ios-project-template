<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Read by Core/Env/Env.swift. Values come from Config/<Flavor>.xcconfig. -->
	<key>APP_ENV</key>
	<string>$(APP_ENV)</string>
	<key>BASE_URL</key>
	<string>$(BASE_URL)</string>
	<!-- Base bundle id (without the flavor suffix), for SecurityGuard's repackaging check. -->
	<key>BASE_BUNDLE_IDENTIFIER</key>
	<string>$(BASE_BUNDLE_IDENTIFIER)</string>
	<key>PINNED_PUBLIC_KEY_HASHES</key>
	<string>$(PINNED_PUBLIC_KEY_HASHES)</string>
	<!-- Must match Core/Constants/BackgroundTaskID.swift. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.technonext.projecttemplate.refresh</string>
		<string>com.technonext.projecttemplate.cleanup</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<!-- Permission usage descriptions: English here, every language in InfoPlist.xcstrings. Remove unused ones. -->
	<key>NSCameraUsageDescription</key>
	<string>The camera is used to scan codes and take photos you choose to upload.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>The microphone is used when you record voice notes or videos.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Photo access lets you pick images to upload.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Your location is used to find delivery addresses and nearby stores.</string>
	<key>NSContactsUsageDescription</key>
	<string>Contacts are used only when you choose to invite or send to a friend.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>This lets us show you more relevant offers.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID keeps your account locked when you leave the app.</string>
	<!-- Custom URL scheme: must match DeepLinkConstants.urlScheme. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>projecttemplate</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
